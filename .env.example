# Only needed if you run jobwatch on your own computer. On GitHub, use secrets instead.
# Email (Gmail): your address and an app password (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_TO=            (default: send to yourself)

# Adzuna job search. Free key: developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Sheet (optional)
GOOGLE_SERVICE_ACCOUNT_JSON=
JOBWATCH_SHEET_ID=
# JOBWATCH_SHEET_TAB=Jobs
